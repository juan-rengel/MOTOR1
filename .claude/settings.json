{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e -- -g:*)",
      "Bash(npm run test:e2e:full)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(npm exec:*)",
      "Bash(npm run assets:demo --:*)",
      "Bash(npm run assets:model:*)",
      "Bash(node scripts/:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.preview)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.test)",
      "Edit(./**/.env.staging)",
      "Edit(./**/.env.preview)",
      "Bash(cat .env:*)",
      "Bash(type .env:*)",
      "Bash(Get-Content .env:*)",
      "Edit(./public/assets/demo/mechanic/**)",
      "Edit(./public/assets/demo/optics/**)",
      "Edit(./public/assets/demo/fashion/**)",
      "Edit(./public/assets/demo/models/**)",
      "Bash(npm run assets:demo)",
      "Bash(node scripts/capture-demo-assets.mjs)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm publish:*)",
      "Bash(firebase deploy:*)",
      "Bash(vercel:*)",
      "Bash(netlify deploy:*)"
    ]
  }
}
